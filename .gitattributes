# Auto detect text files and perform LF normalization
* text=auto

gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

*.apk binary
*.aab binary
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.webp binary
*.woff2 binary

